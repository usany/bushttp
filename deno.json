{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-run --env-file main.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-run --env-file main.test.ts",
    "lintformat": "deno lint; deno fmt",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/expect": "jsr:@std/expect@1",
    "@std/assert": "jsr:@std/assert@1",
    "graphql-yoga": "npm:graphql-yoga@^3.7.3"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "files": {
      "include": ["src/", "*.ts", "*.js"]
    }
  }
}
